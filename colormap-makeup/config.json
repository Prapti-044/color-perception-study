{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Colormap and Makeup",
    "version": "1.0.0",
    "authors": [
      "Shadmaan Hye"
    ],
    "date": "2025-07-09",
    "description": "Here you will answer some questions based on the color perception of the user. This study aims to explore how individuals perceive and respond to different colors.",
    "organizations": [
      "University of Utah"
    ]
  },
  "uiConfig": {
    "contactEmail": "u1452119@utah.edu",
    "helpTextPath": "colormap-makeup/assets/help.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "nextOnEnter": true,
    "studyEndMsg": "**Thank you for completing the study. You may click this link and return to Prolific**: [Prolific Link](https://app.prolific.com/submissions/complete?cc=CHHYW1WW). Or you can use this completion code: CHHYW1WW",
    "participantNameField": "introduction.prolificId",
    "urlParticipantIdParam": "PROLIFIC_PID"
  },
  "baseComponents": {
    "color-difference-base": {
      "type": "website",
      "nextButtonLocation": "belowStimulus",
      "instruction": "In this study, you will see pairs of colored circles in scatterplots. Decide if they are the **Same** or **Different**, click **Check Answer** to verify the actual result, then press **Next** to continue.",
      "instructionLocation": "aboveStimulus",
      "path": "colormap-makeup/assets/color-difference.html",
      "response": [
        {
          "id": "color-difference",
          "prompt": "Are the two colors the same or different?",
          "required": true,
          "location": "belowStimulus",
          "type": "radio",
          "options": [
            "Same",
            "Different"
          ]
        }
      ],
      "provideFeedback": true,
      "allowFailedTraining": true,
      "trainingAttempts": 3

    },
    "scatterplot-base": {
      "type": "react-component",
      "path": "colormap-makeup/vega-scatterplot.tsx",
      "nextButtonLocation": "belowStimulus",
      "instruction": "Are the two colored points the same or different? Please press **f** for same and **j** for different.",
      "instructionLocation": "aboveStimulus",
      "response": [
        {
          "id": "scatterplot-response",
          "prompt": "Are the two colored points the same or different?",
          "required": true,
          "location": "aboveStimulus",
          "type": "reactive",
          "hidden": true
        }
      ],
      "correctAnswer": [
        {
          "id": "scatterplot-response",
          "answer": "Different"
        }
      ]
    },
    "scatterplot-largediff-base": {
      "type": "react-component",
      "path": "colormap-makeup/vega-scatterplot.tsx",
      "nextButtonLocation": "belowStimulus",
