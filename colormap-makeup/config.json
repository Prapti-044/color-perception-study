          "options": [
            "I do not use makeup",
            "I use it occasionally",
            "I use it regularly",
            "I use it professionally"
          ]
        },
        {
          "id": "foundation-shade",
          "prompt": "What color foundation do you typically use? If you recall the brand name and color (e.g., 'NARS Warm Beige') off the top of your head, please list it. If not, describe to your best memory. If not applicable, please write NA.",
          "type": "longText",
          "placeholder": "Please name the brand and color shades of foundation you typically use to the best of your recollection."
        },
        {
          "id": "makeup-products",
          "prompt": "Which makeup products do you regularly use? Please select all that apply from the list below. ",
          "type": "checkbox",
          "options": [
