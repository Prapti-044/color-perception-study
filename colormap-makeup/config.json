        }
      ],
      "correctAnswer": [
        {
          "id": "scatterplot-response",
          "answer": "Different"
        }
      ]
    },
    "scatterplot-samecolor-base": {
      "type": "react-component",
      "path": "colormap-makeup/vega-scatterplot.tsx",
      "nextButtonLocation": "belowStimulus",
      "instruction": "Are the two colored points the same or different? Please press **f** for same and **j** for different.",
      "instructionLocation": "aboveStimulus",
      "response": [
        {
          "id": "scatterplot-response",
