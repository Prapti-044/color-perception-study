{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.2/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Color-Vision Perception",
        "version": "pilot",
        "authors": [ "Shadmaan Hye", "Andrew McNutt", "Kate Isaacs" ],
        "date": "2026-01-26",
        "description": "A study to test the color-vision perception.",
        "organizations": [ "University of Utah" ]
    },
    "uiConfig": {
        "contactEmail": "shadmaanhye@gmail.com",
        "helpTextPath": "color-vision-perception/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "withSidebar": false,
        "nextOnEnter": true,
        "studyEndMsg": "Thank you for completing the study. You may click this link and return to Prolific**: [Prolific Link](https://app.prolific.com/submissions/complete?cc=CHHYW1WW). Or you can use this completion code: <completion code>",
        "participantNameField": "introduction.prolificId",
        "urlParticipantIdParam": "PROLIFIC_PID"
    },
    "baseComponents": {
        "direction-stimuli": {
            "type": "react-component",
            "path": "color-vision-perception/direction-stimuli.tsx",
            "nextButtonLocation": "belowStimulus",
            "response": [
                {
                    "id": "direction-response",
                    "prompt": "In which direction is the shape pointing?",
                    "location": "aboveStimulus",
                    "type": "reactive",
                    "hidden": true
                }
            ]
        }
    },
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "color-vision-perception/assets/introduction.md",
            "response": []
        },
        "halfway-break": {
            "type": "markdown",
            "path": "color-vision-perception/assets/halfway-break.md",
            "response": []
        },
        "thanks": {
            "type": "markdown",
            "path": "color-vision-perception/assets/thanks.md",
            "response": []
        },

        "practice": {
            "baseComponent": "direction-stimuli",
            "description": "Unlimited practice with feedback — easy stimuli, random vector/direction/step",
            "parameters": {
                "vector": 0,
                "startingLocation": 175,
                "practice": true
            }
        },

        "set-v0-r1": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 0 (Red), repetition 1",
            "parameters": {
                "vector": 0,
                "startingLocation": 175,
                "totalSets": 12
            }
        },
        "set-v0-r2": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 0 (Red), repetition 2",
            "parameters": {
                "vector": 0,
                "startingLocation": 175,
                "totalSets": 12
            }
        },
        "set-v0-r3": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 0 (Red), repetition 3",
            "parameters": {
                "vector": 0,
                "startingLocation": 175,
                "totalSets": 12
            }
        },

        "set-v1-r1": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 1 (Blue), repetition 1",
            "parameters": {
                "vector": 1,
                "startingLocation": 175,
                "totalSets": 12
            }
        },
        "set-v1-r2": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 1 (Blue), repetition 2",
            "parameters": {
                "vector": 1,
                "startingLocation": 175,
                "totalSets": 12
            }
        },
        "set-v1-r3": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 1 (Blue), repetition 3",
            "parameters": {
                "vector": 1,
                "startingLocation": 175,
                "totalSets": 12
            }
        },

        "set-v2-r1": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 2 (Magenta), repetition 1",
            "parameters": {
                "vector": 2,
                "startingLocation": 175,
                "totalSets": 12
            }
        },
        "set-v2-r2": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 2 (Magenta), repetition 2",
            "parameters": {
                "vector": 2,
                "startingLocation": 175,
                "totalSets": 12
            }
        },
        "set-v2-r3": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 2 (Magenta), repetition 3",
            "parameters": {
                "vector": 2,
                "startingLocation": 175,
                "totalSets": 12
            }
        },

        "set-v3-r1": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 3 (Lightness), repetition 1",
            "parameters": {
                "vector": 3,
                "startingLocation": 175,
                "totalSets": 12
            }
        },
        "set-v3-r2": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 3 (Lightness), repetition 2",
            "parameters": {
                "vector": 3,
                "startingLocation": 175,
                "totalSets": 12
            }
        },
        "set-v3-r3": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 3 (Lightness), repetition 3",
            "parameters": {
                "vector": 3,
                "startingLocation": 175,
                "totalSets": 12
            }
        }
    },
    "sequence": {
        "order": "fixed",
        "components": [
            "introduction",
            "practice",
            {
                "order": "random",
                "components": [
                    "set-v0-r1",
                    "set-v0-r2",
                    "set-v0-r3",
                    "set-v1-r1",
                    "set-v1-r2",
                    "set-v1-r3",
                    "set-v2-r1",
                    "set-v2-r2",
                    "set-v2-r3",
                    "set-v3-r1",
                    "set-v3-r2",
                    "set-v3-r3"
                ],
                "interruptions": [
                    {
                        "firstLocation": 6,
                        "spacing": 99999,
                        "components": [ "halfway-break" ]
                    }
                ]
            },
            "thanks"
        ]
    }
}
