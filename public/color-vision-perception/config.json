{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.2/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Color-Vision Perception",
        "version": "pilot",
        "authors": [ "Shadmaan Hye", "Andrew McNutt", "Kate Isaacs" ],
        "date": "2026-01-26",
        "description": "A study to test the color-vision perception.",
        "organizations": [ "University of Utah" ]
    },
    "uiConfig": {
        "contactEmail": "shadmaanhye@gmail.com",
        "helpTextPath": "color-vision-perception/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "withSidebar": false,
        "nextOnEnter": true,
        "studyEndMsg": "Thank you for completing the study. You may click this link and return to Prolific**: [Prolific Link](https://app.prolific.com/submissions/complete?cc=CM6T6NWG). Or you can use this completion code: CM6T6NWG",
        "participantNameField": "introduction.prolificId",
        "urlParticipantIdParam": "PROLIFIC_PID"
    },
    "baseComponents": {
        "direction-stimuli": {
            "type": "react-component",
            "path": "color-vision-perception/direction-stimuli.tsx",
            "response": [
                {
                    "id": "direction-response",
                    "prompt": "In which direction is the shape pointing?",
                    "location": "aboveStimulus",
                    "type": "reactive",
                    "hidden": true
                }
            ]
        }
    },
    "importedLibraries": [
        "demographics"
      ],
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "color-vision-perception/assets/introduction.md",
            "response": []
        },
        "consent": {
            "type": "markdown",
            "path": "color-vision-perception/assets/consent.md",
            "response": [],
            "nextButtonText": "Agree"
        },
        "halfway-break": {
            "type": "react-component",
            "path": "color-vision-perception/halfway-break.tsx",
            "response": [
                {
                    "id": "halfway-guess",
                    "prompt": "Click the direction of the squirrel's front paw.",
                    "location": "belowStimulus",
                    "type": "reactive",
                    "hidden": true
                },
                {
                    "id": "halfway-correct",
                    "prompt": "",
                    "location": "belowStimulus",
                    "type": "reactive",
                    "hidden": true
                }
            ]
        },
        "thanks": {
            "type": "markdown",
            "path": "color-vision-perception/assets/thanks.md",
            "response": []
        },

        "demographic-questionnaire-color-theory": {
          "type": "questionnaire",
          "response": [
            {
              "id": "strategies",
              "prompt": "Did you use any particular strategies to complete the task. If yes, please specify the strategies.",
              "type": "longText",
              "placeholder": "Please explain the strategies you used."
            },
            {
              "id": "color-hobby",
              "prompt": "Which of the following activities do you enjoy as a hobby? Check any of the activities below that you enjoy as a hobby.",
              "type": "checkbox",
              "options": [
                "Painting",
                "Drawing",
                "Graphic Design",
                "Photography",
                "I don't participate in any of the above"
              ]
            },
            {
              "id": "color-theory-class",
              "prompt": "Have you ever taken a class or received formal instruction in color theory? ",
              "type": "radio",
              "options": [
                "Yes",
                "No"
              ]
            },
            {
              "id": "color-theory-knowledge",
              "prompt": "What color do you get by mixing equal amounts of red and yellow **paint**? If you're unsure, give your best guess.",
              "type": "longText",
              "placeholder": "Please name the color you get."
            },
            {
              "id": "color-theory-knowledge-2",
              "prompt": "What is the result of mixing red, green, and blue **light** in equal intensity? If you're unsure, give your best guess.",
              "type": "longText",
              "placeholder": "Please name the color you get."
            }
          ]
        },

        "demographic-questionnaire-makeup": {
          "type": "questionnaire",
          "response": [
            {
              "id": "makeup-familiarity",
              "prompt": "Are you familiar with makeup?",
              "type": "radio",
              "options": [
                "Yes",
                "No"
              ]
            },
            {
              "id": "use-makeup",
              "prompt": "Do you use makeup in any form or capacity?",
              "type": "radio",
              "options": [
                "I do not use makeup",
                "I use it occasionally",
                "I use it regularly",
                "I use it professionally"
              ]
            },
            {
              "id": "foundation-shade",
              "prompt": "What color foundation do you typically use? If you recall the brand name and color (e.g., 'NARS Warm Beige') off the top of your head, please list it. If not, describe to your best memory. If not applicable, please write NA.",
              "type": "longText",
              "placeholder": "Please name the brand and color shades of foundation you typically use to the best of your recollection."
            },
            {
              "id": "makeup-products",
              "prompt": "Which makeup products do you regularly use? Please select all that apply from the list below. ",
              "type": "checkbox",
              "options": [
                "Foundation",
                "Concealer",
                "Blush",
                "Bronzer",
                "Eyeshadow",
                "Eyeliner",
                "Mascara",
                "Lipstick",
                "Lip Gloss",
                "Setting Powder",
                "None"
              ]
            }
          ]
        },

        "practice": {
            "baseComponent": "direction-stimuli",
            "description": "Unlimited practice with feedback — easy stimuli, random vector/direction/step",
            "parameters": {
                "vector": 0,
                "maxLocation": 175,
                "practice": true
            }
        },

        "set-v1-r1": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 0 (Red), repetition 1",
            "parameters": {
                "vector": 1,
                "totalSets": 12,
                "maxLocation": 166
            }
        },
        "set-v1-r2": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 0 (Red), repetition 2",
            "parameters": {
                "vector": 1,
                "maxLocation": 166,
                "totalSets": 12
            }
        },
        "set-v1-r3": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 0 (Red), repetition 3",
            "parameters": {
                "vector": 1,
                "maxLocation": 166,
                "totalSets": 12
            }
        },

        "set-v2-r1": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 1 (Blue), repetition 1",
            "parameters": {
                "vector": 2,
                "maxLocation": 134,
                "totalSets": 12
            }
        },
        "set-v2-r2": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 1 (Blue), repetition 2",
            "parameters": {
                "vector": 2,
                "maxLocation": 134,
                "totalSets": 12
            }
        },
        "set-v2-r3": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 1 (Blue), repetition 3",
            "parameters": {
                "vector": 2,
                "maxLocation": 134,
                "totalSets": 12
            }
        },

        "set-v3-r1": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 2 (Magenta), repetition 1",
            "parameters": {
                "vector": 3,
                "maxLocation": 174,
                "totalSets": 12
            }
        },
        "set-v3-r2": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 2 (Magenta), repetition 2",
            "parameters": {
                "vector": 3,
                "maxLocation": 174,
                "totalSets": 12
            }
        },
        "set-v3-r3": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 2 (Magenta), repetition 3",
            "parameters": {
                "vector": 3,
                "maxLocation": 174,
                "totalSets": 12
            }
        },

        "set-v4-r1": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 3 (Lightness), repetition 1",
            "parameters": {
                "vector": 4,
                "maxLocation": 106,
                "totalSets": 12
            }
        },
        "set-v4-r2": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 3 (Lightness), repetition 2",
            "parameters": {
                "vector": 4,
                "maxLocation": 106,
                "totalSets": 12
            }
        },
        "set-v4-r3": {
            "baseComponent": "direction-stimuli",
            "description": "Axis 3 (Lightness), repetition 3",
            "parameters": {
                "vector": 4,
                "maxLocation": 106,
                "totalSets": 12
            }
        }
    },
    "sequence": {
        "order": "fixed",
        "components": [
            "introduction",
            "consent",
            "practice",
            {
                "order": "fixed",
                "components": [
                    {
                        "order": "random",
                        "components": [
                            "set-v1-r1",
                            "set-v2-r1",
                            "set-v3-r1",
                            "set-v4-r1"
                        ]
                    },
                    {
                        "order": "random",
                        "components": [
                            "set-v1-r2",
                            "set-v2-r2",
                            "set-v3-r2",
                            "set-v4-r2"
                        ]
                    },
                    {
                        "order": "random",
                        "components": [
                            "set-v1-r3",
                            "set-v2-r3",
                            "set-v3-r3",
                            "set-v4-r3"
                        ]
                    }
                ],
                "interruptions": [
                    {
                        "spacing": 99999,
                        "firstLocation": 2,
                        "components": [
                            "halfway-break"
                        ]
                    }
                ]
            },
            "$demographics.co.demographics",
            "demographic-questionnaire-color-theory",
            "demographic-questionnaire-makeup",
            "thanks"
        ]
    }
}
