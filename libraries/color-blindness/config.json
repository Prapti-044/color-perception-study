          "withDontKnow": true
        }
      ],
      "correctAnswer": [
        {
          "id": "plate7-response",
          "answer": 74
        }
      ]
    }
  },
  "sequences": {
    "short-test": {
      "id": "short-test",
      "order": "random",
      "components": [   
        "plate2",
        "plate1",
        "plate3",
        "plate7"
      ]
    }
  }
