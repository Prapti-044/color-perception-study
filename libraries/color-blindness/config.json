{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.2/src/parser/LibraryConfigSchema.json",
  "description": "This library is the Ishihara color blindness test. Each component contains an image of an Ishihara plate. The meta attribute of each plate describe what normal vision people, red color blind people, green color blind people, and total color blind people see from this plate. The user is asked to identify the number or pattern in the image. The library also contains two sequences: a short test and a full test. The short test contains 4 components and the full test contains all 24 components.",
  "externalLink": "https://www.colour-blindness.com/colour-blindness-tests/ishihara-colour-test-plates/",
  "components": {
    "plate1": {
      "meta": {
        "plateNumber": 1,
        "normal-color-vision-see": 12,
        "red-color-blindness-see": 12,
        "green-color-blindness-see": 12,
        "total-color-blindness-see": 12,
        "plateType": "demonstration"
      },
      "instruction": "What number do you see in this image?",
      "instructionLocation": "belowStimulus",
      "type": "image",
      "path": "libraries/color-blindness/assets/Ishihara1.png",
      "style": {
        "width": "350px"
      },
      "nextButtonLocation": "belowStimulus",
      "response": [
        {
          "id": "plate1-response",
          "prompt": "Enter the number you see:",
          "required": true,
          "location": "belowStimulus",
          "type": "numerical",
          "withDontKnow": true
        }
      ],
      "correctAnswer": [
        {
          "id": "plate1-response",
          "answer": 12
        }
      ]
    },
    "plate2": {
      "meta": {
        "plateNumber": 2,
        "normal-color-vision-see": 8,
        "red-color-blindness-see": 3,
        "green-color-blindness-see": 3,
        "total-color-blindness-see": "nothing",
        "plateType": "transformation"
      },
      "instruction": "What number do you see in this image?",
      "instructionLocation": "belowStimulus",
      "type": "image",
      "path": "libraries/color-blindness/assets/Ishihara2.png",
      "style": {
        "width": "350px"
      },
      "nextButtonLocation": "belowStimulus",
      "response": [
        {
          "id": "plate2-response",
          "prompt": "Enter the number you see:",
          "required": true,
          "location": "belowStimulus",
          "type": "numerical",
          "withDontKnow": true
        }
      ],
      "correctAnswer": [
        {
          "id": "plate2-response",
          "answer": 8
        }
      ]
    },
    "plate3": {
      "meta": {
        "plateNumber": 3,
        "normal-color-vision-see": 29,
        "red-color-blindness-see": 70,
        "green-color-blindness-see": 70,
        "total-color-blindness-see": "nothing",
        "plateType": "transformation"
      },
      "instruction": "What number do you see in this image?",
      "instructionLocation": "belowStimulus",
      "type": "image",
      "path": "libraries/color-blindness/assets/Ishihara3.png",
      "style": {
        "width": "350px"
      },
      "nextButtonLocation": "belowStimulus",
      "response": [
        {
          "id": "plate3-response",
          "prompt": "Enter the number you see:",
          "required": true,
          "location": "belowStimulus",
          "type": "numerical",
          "withDontKnow": true
        }
      ],
      "correctAnswer": [
        {
          "id": "plate3-response",
          "answer": 29
        }
      ]
    },
    
    "plate7": {
      "meta": {
        "plateNumber": 7,
        "normal-color-vision-see": 74,
        "red-color-blindness-see": 21,
        "green-color-blindness-see": 21,
        "total-color-blindness-see": "nothing",
